generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

// 同步记录：记录最后同步的区块号（核心，避免重复累加）
model SyncRecord {
  id        Int    @id @default(autoincrement())
  lastBlock BigInt @default(0)
  updatedAt DateTime @default(now())
}

// 质押事件表
model StakeEvent {
  id        String @id @default(uuid())
  user      String // 用户地址
  amount    String // 质押数量
  block     BigInt // 区块号
  timestamp Int    // 时间戳
  createdAt DateTime @default(now())
}

// 赎回事件表
model UnstakeEvent {
  id        String @id @default(uuid())
  user      String // 用户地址
  amount    String // 赎回数量
  block     BigInt // 区块号
  timestamp Int    // 时间戳
  createdAt DateTime @default(now())
}

// 统计总表（页面卡片数据）
model Stats {
  id           Int    @id @default(1)
  totalLp      String @default("0") // LP总余额
  totalRedeem  String @default("0") // 可兑付总余额
  totalStaked  String @default("0") // 场内质押
  totalUnstaked String @default("0")// 到期未赎回
  updatedAt    DateTime @default(now())
}
